{
  "name": "messages-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "ng build",
    "lint": "eslint src e2e perf playwright.config.ts playwright.perf.config.ts && stylelint \"src/**/*.scss\"",
    "ng": "ng",
    "prebuild": "node scripts/stamp-version.mjs",
    "prelint": "node scripts/stamp-version.mjs",
    "prestart": "node scripts/stamp-version.mjs",
    "pretest": "node scripts/stamp-version.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "start": "ng serve",
    "test": "ng test --watch=false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "ui-check": "playwright test",
    "perf": "playwright test -c playwright.perf.config.ts",
    "watch": "ng build --watch --configuration development",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@fontsource/roboto": "^5.3.0",
    "@xinutec/ui-harness": "github:xinutec/ui-harness#9acbc25d8f25e3a52b956cdc8aee544d3e0591de",
    "@xinutec/ui-scaffold": "github:xinutec/ui-harness#9acbc25d8f25e3a52b956cdc8aee544d3e0591de&path:/scaffold",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "1.63.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
