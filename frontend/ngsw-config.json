{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/login",
    "!/logout",
    "!/auth/**"
  ],
  "dataGroups": [
    {
      "name": "api",
      "urls": ["/api/me", "/api/conversations", "/api/conversations/*/*/messages**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 300, "maxAge": "30d", "timeout": "3s" }
    },
    {
      "name": "avatars",
      "urls": ["/api/conversations/*/*/avatar**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 200, "maxAge": "30d" }
    }
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**", "/*.(svg|png|jpg|jpeg|webp|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
