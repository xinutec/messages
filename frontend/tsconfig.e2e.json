// Type-checks the e2e tree and the Playwright config, which no other tsconfig
// reaches and Playwright's esbuild transform does not check. `harness.d.mts`
// types the `.mjs`, so no `allowJs`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts", "e2e/**/*.d.mts"]
}
