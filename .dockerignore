# The build context is sent whole to the daemon. Excluding node_modules also
# keeps `COPY frontend/ .` from overwriting the installed layer with a local
# tree of pnpm symlinks, which fails.
target/
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/test-results/
frontend/playwright-report/

# Not part of any image.
android/
.git/
result
result-*
